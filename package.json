{
  "name": "undertow",
  "version": "0.6.7",
  "private": true,
  "type": "module",
  "description": "Undertow — personal music streaming client",
  "main": "./out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build:helper && electron-vite build && electron-builder --win --publish never",
    "dist:dir": "npm run build:helper && electron-vite build && electron-builder --win --dir",
    "build:helper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-helper.ps1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "youtubei.js": "^18.3.0"
  },
  "author": "N3WERS",
  "build": {
    "appId": "ai.n3wers.undertow",
    "productName": "Undertow",
    "copyright": "by N3WERS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/zapret",
        "to": "zapret"
      },
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "N3WERS",
        "repo": "undertow-releases",
        "releaseType": "release"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Undertow",
      "artifactName": "Undertow-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    }
  }
}
